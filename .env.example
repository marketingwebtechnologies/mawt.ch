# MAWT — environment variables (names only, never commit real values).
# Copy to .env.local for development; set production values in Vercel.

# ── Sanity (public identifiers — safe in the client bundle) ──────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# ── Sanity (server-only tokens — NEVER prefix these with NEXT_PUBLIC_) ───────
# Editor/write token, used to create contactLead / newsletterSubscriber docs.
SANITY_API_WRITE_TOKEN=
# Optional Viewer token for admin stats (falls back to the write token).
SANITY_API_READ_TOKEN=
# Shared secret for the /api/revalidate webhook (fail-closed when unset).
# Send it as `Authorization: Bearer <secret>` from the Sanity webhook.
SANITY_REVALIDATE_SECRET=

# ── Admin auth ───────────────────────────────────────────────────────────────
ADMIN_SECRET=
SESSION_SECRET=

# ── Rate limiting (Upstash Redis, REQUIRED in production: admin login and
#    revalidate fail closed without it) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Meta Conversions API (server-only) ───────────────────────────────────────
# Access token generated in Events Manager > dataset 959258244767672 > Settings
# > Conversions API. Without it the server copy of Lead events is skipped.
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager "Test events" code, to see events before going live.
META_CAPI_TEST_EVENT_CODE=

# ── Lead backup (Google Apps Script web app, see mawt-microtest
#    scripts/apps-script-secours-leads.gs). Server copy of every lead and
#    browser-side fallback when the site API fails. Public URL is safe to expose.
LEADS_BACKUP_URL=
LEADS_BACKUP_SECRET=
NEXT_PUBLIC_LEADS_BACKUP_URL=

# ── Email (SMTP preferred; Resend as fallback) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=
RESEND_API_KEY=

# ── Newsletter provider (production refuses subscriptions when unset) ────────
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=

# ── Contact page fallbacks (shown when Sanity has no contact document) ───────
CONTACT_FALLBACK_HEADLINE=
CONTACT_FALLBACK_EMAIL=
CONTACT_FALLBACK_PHONE=
CONTACT_FALLBACK_CITY=
CONTACT_FALLBACK_ADDRESS=
